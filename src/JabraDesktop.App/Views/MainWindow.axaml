<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:JabraDesktop.App.ViewModels" xmlns:core="using:JabraDesktop.Core"
 x:Class="JabraDesktop.App.Views.MainWindow" x:DataType="vm:MainViewModel"
 Title="Jabra Desktop" Width="1080" Height="760" MinWidth="780" MinHeight="560"
 Background="{DynamicResource PageBrush}" FontFamily="Inter, Noto Sans, DejaVu Sans">
 <Window.Styles><StyleInclude Source="/Styles/Theme.axaml" /></Window.Styles>
 <Window.DataTemplates>
  <DataTemplate DataType="vm:PeerRow" x:DataType="vm:PeerRow">
   <Border Classes="card" Margin="0,0,0,10">
    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
     <Border Background="{DynamicResource SideBrush}" CornerRadius="12" Width="44" Height="44" VerticalAlignment="Center">
      <Path Data="M 3,14 L 3,10 C 3,0 19,0 19,10 L 19,14 M 3,10 L 6,10 L 6,18 L 3,18 Z M 16,10 L 19,10 L 19,18 L 16,18 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" />
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" />
      <Button Content="⋯" IsVisible="{Binding IsSaved}" ToolTip.Tip="Weitere Aktionen" AutomationProperties.Name="Weitere Geräteaktionen">
       <Button.Flyout><MenuFlyout><MenuItem Header="Entkoppeln …" Command="{Binding UnpairCommand}" /></MenuFlyout></Button.Flyout>
      </Button>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.DataTemplates>
 <Grid ColumnDefinitions="250,*">
  <Border Background="{DynamicResource SideBrush}" Padding="22,30">
   <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="8" Margin="8,0,0,36">
     <TextBlock Text="jabra / desktop" FontSize="23" FontWeight="Bold" />
     <TextBlock Text="DEIN SOUND. DEINE VERBINDUNG." Classes="eyebrow" FontSize="9" LetterSpacing="1" />
    </StackPanel>
    <TextBlock Grid.Row="1" Text="DEINE GERÄTE" Classes="eyebrow" Margin="10,0,0,12" />
    <ListBox Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate x:DataType="core:DeviceInfo">
      <StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Jabra USB" Classes="muted" FontSize="11" /></StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Spacing="14">
     <Button Content="Hell / Dunkel" Click="ToggleTheme" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
     <TextBlock Text="Für Linux entwickelt.&#10;Unabhängige Desktop-App." Classes="muted" FontSize="11" LineHeight="18" Margin="8,0" />
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,34" Spacing="24">
    <StackPanel Spacing="10">
     <TextBlock Text="VERBINDUNGEN" Classes="eyebrow" />
     <TextBlock Text="{Binding DeviceTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
     <TextBlock Text="{Binding DeviceSubtitle}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card">
     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="12">
      <StackPanel Spacing="7"><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" /><TextBlock Text="Suchen, koppeln und nahtlos wechseln." Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
      <Button Grid.Column="1" Content="+ Gerät hinzufügen" Classes="primary" Command="{Binding ScanCommand}" VerticalAlignment="Center" />
     </Grid>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasError}" BorderBrush="#BD8364">
     <StackPanel Spacing="12"><TextBlock Text="Verbindung prüfen" FontWeight="SemiBold" /><TextBlock Text="{Binding Error}" TextWrapping="Wrap" /><Button Content="Erneut initialisieren" Command="{Binding RetryCommand}" /></StackPanel>
    </Border>
    <StackPanel Spacing="14" IsVisible="{Binding HasDongle}">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Gespeicherte Geräte" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Aktualisieren" Command="{Binding RefreshCommand}" /></Grid>
     <ItemsControl ItemsSource="{Binding Peers}" />
     <TextBlock Text="Noch keine Kopplungen. Füge dein erstes Headset hinzu." IsVisible="{Binding NoPeers}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Spacing="14" IsVisible="{Binding ShowSearch}">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Geräte in der Nähe" FontSize="18" FontWeight="SemiBold" /><Button Grid.Column="1" Content="Suche beenden" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" /></Grid>
     <TextBlock Text="Schalte dein Headset in den Pairing-Modus. Die Suche endet nach 30 Sekunden. Anschließend kannst du ein gefundenes Gerät koppeln." Classes="muted" TextWrapping="Wrap" />
     <TextBlock Text="{Binding SearchSummary}" Classes="muted" TextWrapping="Wrap" />
     <ItemsControl ItemsSource="{Binding Results}" />
    </StackPanel>
    <Border Classes="card" IsVisible="{Binding HasDevice}">
     <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
      <StackPanel Spacing="8"><TextBlock Text="AKKU" Classes="eyebrow" /><TextBlock Text="{Binding BatteryText}" Classes="muted" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="FIRMWARE" Classes="eyebrow" /><TextBlock Text="{Binding FirmwareText}" Classes="muted" /></StackPanel>
     </Grid>
    </Border>
    <TextBlock Text="Die verfügbaren Funktionen hängen vom angeschlossenen Gerät ab." Classes="muted" FontSize="11" TextWrapping="Wrap" />
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
