<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:JabraDesktop.App.ViewModels"
 x:Class="JabraDesktop.App.Views.MainWindow" x:DataType="vm:MainViewModel"
 Title="{Binding Texts[AppName]}" Width="1080" Height="760" MinWidth="780" MinHeight="560"
 Background="{DynamicResource PageBrush}" FontFamily="Inter, Noto Sans, DejaVu Sans">
 <Window.Styles><StyleInclude Source="/Styles/Theme.axaml" /></Window.Styles>
 <Window.DataTemplates>
  <DataTemplate DataType="vm:PeerRow" x:DataType="vm:PeerRow">
   <Border Classes="card" Margin="0,0,0,10">
    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
     <Border Background="{DynamicResource SideBrush}" CornerRadius="12" Width="44" Height="44" VerticalAlignment="Center">
      <Path Data="M 3,14 L 3,10 C 3,0 19,0 19,10 L 19,14 M 3,10 L 6,10 L 6,18 L 3,18 Z M 16,10 L 19,10 L 19,18 L 16,18 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
      <Button Content="{Binding Name}" Command="{Binding SelectCommand}" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" />
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" />
      <Button Content="⋯" IsVisible="{Binding IsSaved}" ToolTip.Tip="{Binding Texts[MoreActions]}" AutomationProperties.Name="{Binding Texts[MoreDeviceActions]}">
       <Button.Flyout><MenuFlyout>
        <MenuItem Header="{Binding Texts[RenameBluetooth]}" Command="{Binding RenameCommand}" IsVisible="{Binding CanRenameBluetooth}" />
        <MenuItem Header="{Binding Texts[UnpairMenu]}" Command="{Binding UnpairCommand}" />
       </MenuFlyout></Button.Flyout>
      </Button>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>

  <DataTemplate DataType="vm:DongleTreeItemViewModel" x:DataType="vm:DongleTreeItemViewModel">
   <StackPanel Spacing="9" Margin="0,0,0,18">
    <Button Command="{Binding Device.SelectCommand}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent">
     <StackPanel Spacing="3">
      <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Device.RoleLabel}" Classes="muted" FontSize="11" />
      <TextBlock Text="{Binding Device.TelemetrySummary}" IsVisible="{Binding Device.HasTelemetry}" Classes="muted" FontSize="11" />
     </StackPanel>
    </Button>
    <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Peers}" Margin="14,0,0,0">
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PeerRow">
      <ToggleButton Classes="navPeer" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,9" Margin="0,2">
       <StackPanel Spacing="4">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" />
        <TextBlock IsVisible="{Binding HasTelemetry}" Text="{Binding TelemetrySummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
       </StackPanel>
      </ToggleButton>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </DataTemplate>
 </Window.DataTemplates>
 <Grid ColumnDefinitions="290,*">
  <Border Background="{DynamicResource SideBrush}" Padding="22,30">
   <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="8" Margin="8,0,0,36">
     <TextBlock Text="jabra / desktop" FontSize="23" FontWeight="Bold" />
     <TextBlock Text="{Binding Texts[BrandTagline]}" Classes="eyebrow" FontSize="9" LetterSpacing="1" />
    </StackPanel>
    <TextBlock Grid.Row="1" Text="{Binding Texts[DevicesSection]}" Classes="eyebrow" Margin="10,0,0,12" />
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <ItemsControl ItemsSource="{Binding Dongles}" />
      <TextBlock Text="{Binding Texts[StandaloneDevices]}" Classes="eyebrow" Margin="8,8,0,12" IsVisible="{Binding HasStandaloneDevices}" />
      <ItemsControl ItemsSource="{Binding StandaloneDevices}">
       <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DeviceListItemViewModel">
        <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Left" Background="Transparent" Padding="10,8">
         <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding RoleLabel}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding IdentifierText}" IsVisible="{Binding HasIdentifier}" Classes="muted" FontSize="10" /><TextBlock Text="{Binding TelemetrySummary}" IsVisible="{Binding HasTelemetry}" Classes="muted" FontSize="11" /></StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Spacing="14">
     <TextBlock Text="{Binding Texts[LinuxDescription]}" Classes="muted" FontSize="11" LineHeight="18" Margin="8,0" />
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,34" Spacing="24">
    <StackPanel Spacing="10">
     <TextBlock Text="{Binding Texts[Connections]}" Classes="eyebrow" />
     <TextBlock Text="{Binding DeviceTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
     <TextBlock Text="{Binding DeviceSubtitle}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card" IsVisible="{Binding ShowDeviceOverview}">
     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="12">
      <StackPanel Spacing="7"><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" /><TextBlock Text="{Binding Texts[SearchPairingSwitch]}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
      <Button Grid.Column="1" Content="{Binding Texts[AddDevice]}" Classes="primary" Command="{Binding ScanCommand}" VerticalAlignment="Center" />
     </Grid>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasError}" BorderBrush="#BD8364">
     <StackPanel Spacing="12"><TextBlock Text="{Binding Texts[ConnectionProblem]}" FontWeight="SemiBold" /><TextBlock Text="{Binding Error}" TextWrapping="Wrap" /><Button Content="{Binding Texts[Reinitialize]}" Command="{Binding RetryCommand}" /></StackPanel>
    </Border>
    <StackPanel Spacing="14" IsVisible="{Binding HasDongle}">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Texts[SavedDevices]}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="{Binding Texts[Refresh]}" Command="{Binding RefreshCommand}" /></Grid>
     <ItemsControl ItemsSource="{Binding Peers}" />
     <TextBlock Text="{Binding Texts[NoPairs]}" IsVisible="{Binding NoPeers}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card" IsVisible="{Binding ShowEndpointStatus}">
     <StackPanel Spacing="14">
      <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEndpointSelected}">
       <Button Content="{Binding SelectedPeer.ActionLabel}" Command="{Binding SelectedPeer.ActionCommand}" />
       <Button Content="{Binding Texts[RenameBluetooth]}" Command="{Binding SelectedPeer.RenameCommand}" IsVisible="{Binding SelectedPeer.CanRenameBluetooth}" />
       <Button Content="{Binding Texts[Unpair]}" Command="{Binding SelectedPeer.UnpairCommand}" />
      </StackPanel>
     </StackPanel>
    </Border>
    <StackPanel Spacing="14" IsVisible="{Binding ShowSearch}">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Texts[NearbyDevices]}" FontSize="18" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{Binding Texts[StopSearch]}" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" /></Grid>
     <TextBlock Text="{Binding Texts[PairingInstructions]}" Classes="muted" TextWrapping="Wrap" />
     <TextBlock Text="{Binding SearchSummary}" Classes="muted" TextWrapping="Wrap" />
     <ItemsControl ItemsSource="{Binding Results}" />
    </StackPanel>
    <Border Classes="card" IsVisible="{Binding HasProperties}">
     <StackPanel Spacing="14">
      <WrapPanel Orientation="Horizontal">
       <StackPanel Spacing="8" MinWidth="200" Margin="0,0,20,8" IsVisible="{Binding ShowBattery}"><TextBlock Text="{Binding Texts[Battery]}" Classes="eyebrow" /><TextBlock Text="{Binding BatteryText}" Classes="muted" /></StackPanel>
       <StackPanel Spacing="8" MinWidth="200" IsVisible="{Binding ShowFirmware}"><TextBlock Text="{Binding Texts[Firmware]}" Classes="eyebrow" /><TextBlock Text="{Binding FirmwareText}" Classes="muted" /></StackPanel>
      </WrapPanel>
      <Button HorizontalAlignment="Left" Content="{Binding RefreshPropertiesText}" IsVisible="{Binding CanRefreshProperties}" Command="{Binding RefreshPropertiesCommand}" />
     </StackPanel>
    </Border>
    <TextBlock Text="{Binding Texts[FeatureDependsOnDevice]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
