<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JabraDesktop.App.Views.ConsentWindow" Width="620" Height="650" MinWidth="480" MinHeight="460" CanResize="True" WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
  <StackPanel Grid.Row="0" Spacing="8">
   <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
   <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Opacity="0.8" />
  </StackPanel>
  <Border Grid.Row="1" BorderThickness="1" CornerRadius="8" Padding="16">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <TextBlock x:Name="TermsText" TextWrapping="Wrap" LineHeight="22" />
   </ScrollViewer>
  </Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
   <Button x:Name="DeclineButton" MinWidth="150" />
   <Button x:Name="AcceptButton" MinWidth="190" Classes="accent" />
  </StackPanel>
 </Grid>
</Window>
