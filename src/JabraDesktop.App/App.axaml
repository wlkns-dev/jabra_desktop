<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JabraDesktop.App.App" RequestedThemeVariant="Dark">
 <Application.Styles><FluentTheme /></Application.Styles>
 <TrayIcon.Icons>
  <TrayIcons>
   <TrayIcon Icon="/Assets/jabra-desktop.ico" ToolTipText="Jabra Desktop" IsVisible="False">
    <TrayIcon.Menu>
     <NativeMenu>
      <NativeMenuItem Header="Öffnen" Click="OpenFromTray" />
      <NativeMenuItem Header="Autostart" ToggleType="CheckBox" IsChecked="False" IsEnabled="False" Click="ToggleAutostart" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Beenden" Click="QuitFromTray" />
     </NativeMenu>
    </TrayIcon.Menu>
   </TrayIcon>
  </TrayIcons>
 </TrayIcon.Icons>
</Application>
